  <CheatEntries>
    <CheatEntry>
      <ID>4670</ID>
      <Description>"Vida Infinita (Salud siempre al máximo)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(_character,ShadowOfWar.exe,F3 0F 10 80 2C 04 00 00 48)
alloc(new_hp,$100,_character)
label(return)
registersymbol(_character)
new_hp:
  movss xmm1,[rax+428]
  movss [rax+42c],xmm1
  movss xmm0,[rax+42c]
  jmp return
_character:
  jmp new_hp
  nop 3
return:
[DISABLE]
_character:
  db F3 0F 10 80 2C 04 00 00
dealloc(new_hp)
unregistersymbol(_character)
</AssemblerScript>
    </CheatEntry>
