  Author : Reverser (Cleaned)
}

[ENABLE]
aobscanmodule(Might,ShadowOfWar.exe,F3 0F 10 82 D0 02 00 00)
alloc(newmem,$1000,Might)

label(code)
label(return)

newmem:
  push rax
  mov rax,[rdx+00000348] // Obtiene el valor máximo de Might de la barra
  movss [rdx+000002D0],rax // Lo fija como actual
  pop rax

code:
  movss xmm0,[rdx+000002D0]
  jmp return

Might:
  jmp newmem
  nop 3
return:
registersymbol(Might)

[DISABLE]
Might:
  db F3 0F 10 82 D0 02 00 00

unregistersymbol(Might)
dealloc(newmem)
</AssemblerScript>
