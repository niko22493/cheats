[ENABLE]
aobscanmodule(hitCounter,ShadowOfWar.exe,66 89 B7 88 01 00 00)
alloc(newmem,$1000,hitCounter)

label(code)
label(return)

newmem:
  // Comprueba si es el jugador mediante el offset de puntero válido
  cmp [rdi+170],0
  je code
  
  // Mantiene o incrementa el contador de golpes sin dejar que baje a 0
  cmp si,[rdi+00000188]
  jge code
  mov si,[rdi+00000188]

code:
  mov [rdi+00000188],si
  jmp return

hitCounter:
  jmp newmem
  nop 2
return:
registersymbol(hitCounter)

[DISABLE]
hitCounter:
  db 66 89 B7 88 01 00 00

unregistersymbol(hitCounter)
dealloc(newmem)
</AssemblerScript>
