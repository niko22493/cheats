<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>40</ID>
      <Description>"Vida Infinita (Player HP)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : ShadowOfWar.exe
  Author : Reverser (Cleaned)
}

[ENABLE]
aobscanmodule(HP_Read,ShadowOfWar.exe,F3 0F 10 80 2C 04 00 00 48)
alloc(newmem,$1000,HP_Read)

label(code)
label(return)

newmem:
  push rax
  mov rax,[rcx+000026A8]
  test rax,rax
  je @F
  // Fuerza la salud actual al valor máximo de salud (Max HP)
  movss xmm0,[rax+00000428]
  movss [rax+0000042C],xmm0
@@:
  pop rax

code:
  movss xmm0,[rax+0000042C]
  jmp return

HP_Read:
  jmp newmem
  nop 3
return:
registersymbol(HP_Read)

[DISABLE]
HP_Read:
  db F3 0F 10 80 2C 04 00 00

unregistersymbol(HP_Read)
dealloc(newmem)
</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>22</ID>
      <Description>"Might Infinito - Jugador (Player Might)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
