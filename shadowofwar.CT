[ENABLE]
aobscanmodule(Arrow,ShadowOfWar.exe,3b ?? 0f 84 ?? ?? ?? ?? 89 ?? 88 00 00 00 49 ?? ?? e8 ?? ?? ?? ?? 48 ?? ?? 48 ?? ?? e8)
alloc(newmem,$1000,Arrow)

label(code)
label(return)

newmem:
  // Fuerza los valores de las flechas al máximo cargado en el puntero
  mov edx,[rcx+00000054]

code:
  mov [rcx+00000088],edx
  mov rdx,r8
  jmp return

Arrow+8:
  jmp newmem
  nop
return:
registersymbol(Arrow)

[DISABLE]
Arrow+8:
  db 89 91 88 00 00 00

unregistersymbol(Arrow)
