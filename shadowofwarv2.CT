<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>999</ID>
      <Description>"Script General - Shadow of War (Activar primero)"</Description>
      <Options moHideChildren="1"/>
      <Color>0000FF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : ShadowOfWar.exe
  Author : Reverser / Adaptado con rutinas nativas estables para DeckyTrainers
}

[ENABLE]

// --- ASIGNACIÓN DE MEMORIA Y BANDERAS ---
alloc(player_base,8)
registersymbol(player_base)

alloc(t_hp,8)
registersymbol(t_hp)
t_hp:
dd 0

alloc(t_might,8)
registersymbol(t_might)
t_might:
dd 0

alloc(t_mmight,8)
registersymbol(t_mmight)
t_mmight:
dd 0

alloc(t_arrow,8)
registersymbol(t_arrow)
t_arrow:
dd 0

alloc(t_focus,8)
registersymbol(t_focus)
t_focus:
dd 0

alloc(t_combo,8)
registersymbol(t_combo)
t_combo:
dd 0

// --- ESCANEO DE FUNCIONES NATIVAS ---
aobscanmodule(SetMight,ShadowOfWar.exe,48 8B C4 48 89 58 08 48 89 70 10 48 89 78 18 55 48 8D 68 A1 48 81 EC A0 00 00 00 0F)
registersymbol(SetMight)

aobscanmodule(SetMountMight,ShadowOfWar.exe,40 53 48 83 EC 50 F3 0F 10 A1)
registersymbol(SetMountMight)

aobscanmodule(SetFocus,ShadowOfWar.exe,48 83 EC 28 80 3D * * * * 00 4C 8B D1)
registersymbol(SetFocus)

// Gancho principal de actualización del jugador
aobscanmodule(Activate,ShadowOfWar.exe,48 8B 80 C8 0A)
registersymbol(Activate)

alloc(newmem,2048,Activate)
label(returnhere)
label(originalcode)
label(exit)
label(check_hp)
label(check_might)
label(check_mmight)
label(check_focus)
label(check_combo)

newmem:
  push rax
  push rcx
  push rdx
  push r8
  push r9
  
  // Obtiene el puntero base del jugador de forma idéntica a la tabla de referencia
  mov rax,[rax+00000AC0]
  test rax,rax
  je originalcode
  mov rax,[rax+00000888]
  test rax,rax
  je originalcode
  mov [player_base],rax

  // Ejecuta las rutinas según las banderas activadas
  call check_hp
  call check_might
  call check_mmight
  call check_focus
  call check_combo

originalcode:
  pop r9
  pop r8
  pop rdx
  pop rcx
  pop rax
  mov rax,[rax+00000AC8]

exit:
  jmp returnhere


// --- RUTINA 1: VIDA INFINITA ---
check_hp:
  push rax
  cmp [t_hp],0
  je @F
  mov rax,[player_base]
  test rax,rax
  je @F
  mov rax,[rax+000026A8] // Puntero interno del héroe
  test rax,rax
  je @F
  movss xmm1,[rax+00000428] // Max HP
  movss [rax+0000042C],xmm1 // Current HP fijado al máximo al instante
@@:
  pop rax
  ret


// --- RUTINA 2: MIGHT JUGADOR (Usa la función nativa SetMight) ---
check_might:
  push rax
  cmp [t_might],0
  je @F
  mov rax,[player_base]
  test rax,rax
  je @F
  mov rax,[rax+000026A8]
  test rax,rax
  je @F
  mov rcx,[rax+00000338]
  test rcx,rcx
  je @F
  movss xmm1,[rcx+000003A8]
  comiss xmm1,[rcx+000002D0]
  jle @F
  xor r8d,r8d
  sub rsp,20
  call SetMight
  add rsp,20
@@:
  pop rax
  ret


// --- RUTINA 3: MIGHT MONTURA ---
check_mmight:
  push rax
  cmp [t_mmight],0
  je @F
  mov rax,[player_base]
  test rax,rax
  je @F
  mov rax,[rax+00002578] // Puntero de montura
  test rax,rax
  je @F
  mov rcx,[rax+00000348]
  test rcx,rcx
  je @F
  movss xmm1,[rcx+00000330]
  subss xmm1,[rcx+000002D8]
  sub rsp,20
  call SetMountMight
  add rsp,20
@@:
  pop rax
  ret


// --- RUTINA 4: FOCUS INFINITO ---
check_focus:
  push rax
  cmp [t_focus],0
  je @F
  mov rax,[player_base]
  test rax,rax
  je @F
  mov rax,[rax+000026A8]
  test rax,rax
  je @F
  mov rcx,[rax+00000300]
  test rcx,rcx
  je @F
  movss xmm1,[rcx+000000A8]
  subss xmm1,[rcx+0000023C]
  sub rsp,20
  call SetFocus
  add rsp,20
@@:
  pop rax
  ret


// --- RUTINA 5: HIT COMBO ---
check_combo:
  push rax
  cmp [t_combo],0
  je @F
  mov rax,[player_base]
  test rax,rax
  je @F
  mov rax,[rax+000026A8]
  test rax,rax
  je @F
  // Bloqueo de reseteo de combo en el offset de racha
  cmp [rax+00000188],0
  je @F
@@:
  pop rax
  ret


Activate:
  jmp newmem
  nop 2
returnhere:

[DISABLE]

dealloc(player_base)
unregistersymbol(player_base)
dealloc(t_hp)
unregistersymbol(t_hp)
dealloc(t_might)
unregistersymbol(t_might)
dealloc(t_mmight)
unregistersymbol(t_mmight)
dealloc(t_arrow)
unregistersymbol(t_arrow)
dealloc(t_focus)
unregistersymbol(t_focus)
dealloc(t_combo)
unregistersymbol(t_combo)

unregistersymbol(SetMight)
unregistersymbol(SetMountMight)
unregistersymbol(SetFocus)
unregistersymbol(Activate)
dealloc(newmem)

Activate:
  db 48 8B 80 C8 0A 00 00
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1001</ID>
          <Description>"Vida Infinita"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
t_hp:
  dd 1
[DISABLE]
t_hp:
  dd 0
          </AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1002</ID>
          <Description>"Might Infinito - Jugador"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
t_might:
  dd 1
[DISABLE]
t_might:
  dd 0
          </AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1003</ID>
          <Description>"Might Infinito - Montura"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
t_mmight:
  dd 1
[DISABLE]
t_mmight:
  dd 0
          </AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1004</ID>
          <Description>"Focus Infinito"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
t_focus:
  dd 1
[DISABLE]
t_focus:
  dd 0
          </AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>1005</ID>
          <Description>"Hit Combo Infinito"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
t_combo:
  dd 1
[DISABLE]
t_combo:
  dd 0
          </AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
  </CheatEntries>
  <UserdefinedSymbols/>
</CheatTable>
